{
  "name": "miliastra-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xcr1234/miliastra-template.git"
  },
  "homepage": "https://github.com/xcr1234/miliastra-template#readme",
  "bugs": {
    "url": "https://github.com/xcr1234/miliastra-template/issues"
  },
  "type": "module",
  "description": "Project-scoped Miliastra skills, MCP tools, modular Lua build and deployment",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "setup": "node tools/setup-project.mjs",
    "check": "node scripts/check-integrations.mjs",
    "build": "node tools/lua-project.mjs build",
    "build:lua": "node tools/lua-project.mjs build",
    "deploy:lua": "node tools/lua-project.mjs deploy",
    "test": "node --test scripts/test-save-references.mjs scripts/test-lua-bundle.mjs scripts/test-lua-project.mjs scripts/test-setup.mjs scripts/test-design-tools.mjs",
    "check:saves": "node tools/check-save-references.mjs",
    "design:check": "node scripts/check-design-skills.mjs",
    "design:taste": "node tools/design-tools.mjs taste",
    "design:impeccable": "node tools/design-tools.mjs impeccable",
    "preview": "npm run build:lua && npm run check:saves && beyond-simulator-web --workspace . --open"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "beyond-simulator-mcp": "0.4.1",
    "beyond-simulator-web": "0.4.1",
    "fengari": "0.1.5",
    "undici": "8.11.2",
    "zod": "4.6.6"
  }
}
